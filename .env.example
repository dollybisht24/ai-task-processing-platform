# ==========================================
# AI Task Processing Platform Configuration
# ==========================================

# Node / Express Backend Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017/ai_task_platform
# In Docker Compose: mongodb://mongodb:27017/ai_task_platform

# Cache & Message Queue (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# In Docker Compose: REDIS_HOST=redis

# JWT Authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Python Background Worker Configuration
WORKER_ID=worker-local-1
STREAM_KEY=tasks:stream
CONSUMER_GROUP=task_workers
LOG_LEVEL=INFO

# Frontend Configuration (Vite)
VITE_API_BASE_URL=http://localhost:5000/api
